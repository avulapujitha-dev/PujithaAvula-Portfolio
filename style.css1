@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
    --bg: #090914;
    --card: #121222;
    --purple: #a78bfa;
    --pink: #e879f9;
    --text: #f5f3ff;
    --muted: #a1a1b5;
    --border: rgba(167, 139, 250, 0.18);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', sans-serif;
    background:
        radial-gradient(ellipse at 15% 10%, #24163d 0%, transparent 35%),
        radial-gradient(ellipse at 85% 45%, #191538 0%, transparent 35%),
        var(--bg);
    color: var(--text);
    line-height: 1.7;
}

a {
    text-decoration: none;
    color: inherit;
}

/* NAVBAR */

.navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 8%;
    background: rgba(9, 9, 20, 0.88);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid var(--border);
}

.logo {
    font-size: 30px;
    font-weight: 800;
    color: white;
}

.logo span {
    color: var(--purple);
}

.navbar nav {
    display: flex;
    gap: 25px;
}

.navbar nav a {
    color: var(--muted);
    font-size: 13px;
    transition: 0.3s;
}

.navbar nav a:hover {
    color: var(--purple);
}

.nav-btn {
    padding: 10px 20px;
    border: 1px solid var(--purple);
    border-radius: 8px;
    color: var(--purple);
    font-size: 13px;
    transition: 0.3s;
}

.nav-btn:hover {
    background: var(--purple);
    color: #090914;
}

/* COMMON SECTIONS */

.section {
    padding: 100px 10%;
}

.section-heading {
    margin-bottom: 45px;
}

.section-heading > p {
    color: var(--purple);
    font-size: 12px;
    letter-spacing: 3px;
    font-weight: 700;
}

.section-heading h2 {
    font-size: 38px;
    margin-top: 8px;
}

.section-heading h2 span {
    color: var(--purple);
}

/* HERO */

.hero {
    min-height: 650px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 50px;
}

.availability {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 15px;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #86efac;
    border-radius: 30px;
    font-size: 12px;
    margin-bottom: 30px;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 10px #4ade80;
}

.intro {
    color: var(--muted);
    letter-spacing: 5px;
    font-size: 14px;
}

.hero h1 {
    font-size: clamp(45px, 6vw, 75px);
    line-height: 1.2;
    margin: 12px 0;
}

.hero h1 span {
    background: linear-gradient(90deg, var(--purple), var(--pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero h2 {
    font-size: 24px;
    color: var(--muted);
    font-weight: 500;
}

.hero-description {
    color: var(--muted);
    max-width: 580px;
    margin: 25px 0;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.primary-btn,
.secondary-btn {
    padding: 13px 22px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    transition: 0.3s;
}

.primary-btn {
    background: linear-gradient(90deg, var(--purple), var(--pink));
    color: #100b1d;
}

.secondary-btn {
    border: 1px solid var(--border);
    color: white;
}

.primary-btn:hover,
.secondary-btn:hover {
    transform: translateY(-4px);
}

.social-links {
    display: flex;
    gap: 25px;
    margin-top: 35px;
}

.social-links a {
    color: var(--muted);
    font-size: 13px;
}

.social-links a:hover {
    color: var(--purple);
}

/* DEVELOPER VISUAL */

.hero-visual {
    display: flex;
    justify-content: center;
}

.visual-card {
    width: 100%;
    max-width: 400px;
    padding: 25px;
    background: linear-gradient(145deg, #1b1932, #10101e);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: 0 20px 70px rgba(125, 80, 255, 0.15);
    animation: float 4s ease-in-out infinite;
}

.card-top {
    display: flex;
    align-items: center;
    gap: 7px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
}

.card-top span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f87171;
}

.card-top span:nth-child(2) {
    background: #facc15;
}

.card-top span:nth-child(3) {
    background: #4ade80;
}

.card-top small {
    color: var(--muted);
    margin-left: 10px;
}

.code-content {
    padding: 25px 0;
    font-family: monospace;
    font-size: 13px;
    color: #ddd6fe;
    line-height: 2.2;
}

.code-purple {
    color: #c084fc;
}

.code-green {
    color: #86efac;
}

.developer-symbol {
    width: 110px;
    height: 110px;
    margin: 5px auto;
    display: grid;
    place-items: center;
    font-size: 40px;
    font-weight: 800;
    border-radius: 50%;
    background: linear-gradient(135deg, #8b5cf6, #e879f9);
    color: white;
    box-shadow: 0 0 45px rgba(168, 85, 247, 0.35);
}

.visual-caption {
    text-align: center;
    color: var(--muted);
    font-size: 12px;
    margin-top: 15px;
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
}

/* STATS */

.stats {
    margin: 0 10%;
    padding: 30px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--border);
    border-radius: 15px;
    text-align: center;
}

.stats h2 {
    color: var(--purple);
    font-size: 30px;
}

.stats p {
    color: var(--muted);
    font-size: 12px;
}

/* ABOUT */

.about-card,
.skill-card,
.project-card,
.timeline-card,
.education-card,
.achievement-card,
.contact-card {
    background: linear-gradient(145deg, #17172a, #10101c);
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 30px;
    transition: 0.3s;
}

.about-card:hover,
.skill-card:hover,
.project-card:hover,
.education-card:hover,
.achievement-card:hover {
    transform: translateY(-6px);
    border-color: var(--purple);
}

.about-card h3,
.contact-card h3 {
    font-size: 22px;
    margin-bottom: 15px;
}

.about-card p,
.project-card p,
.timeline-card p,
.contact-card p {
    color: var(--muted);
    margin-bottom: 15px;
}

.location {
    color: var(--purple) !important;
}

/* SKILLS */

.skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.skill-card h3 {
    margin-bottom: 20px;
    font-size: 18px;
}

.skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 20px 0;
}

.skill-tags span {
    padding: 7px 13px;
    border-radius: 6px;
    background: rgba(167, 139, 250, 0.1);
    border: 1px solid var(--border);
    color: #d8b4fe;
    font-size: 12px;
}

/* PROJECTS */

.projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
}

.project-number {
    color: var(--purple);
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 700;
}

.project-card h3 {
    font-size: 20px;
    margin: 15px 0;
}

.project-card > a {
    color: var(--purple);
    font-size: 13px;
    font-weight: 600;
}

.project-card > a:hover {
    color: var(--pink);
}

/* EXPERIENCE & EDUCATION */

.timeline-card {
    border-left: 3px solid var(--purple);
}

.timeline-card h3 {
    margin: 12px 0;
}

.education-list {
    display: grid;
    gap: 18px;
}

.education-card {
    border-left: 3px solid var(--purple);
}

.education-card span {
    color: var(--purple);
    font-weight: 700;
    font-size: 13px;
}

.education-card h3 {
    margin: 8px 0;
}

.education-card p {
    color: var(--muted);
}

/* ACHIEVEMENTS */

.achievement-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.achievement-card {
    color: #ddd6fe;
}

/* CONTACT */

.contact-card {
    text-align: center;
    padding: 55px 25px;
}

.contact-card p {
    max-width: 550px;
    margin: 15px auto;
}

.contact-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
    margin: 30px 0;
}

.contact-links a {
    padding: 12px 20px;
    border-radius: 8px;
    background: rgba(167, 139, 250, 0.12);
    border: 1px solid var(--border);
    color: var(--purple);
    font-size: 13px;
    transition: 0.3s;
}

.contact-links a:hover {
    background: var(--purple);
    color: #090914;
}

/* FOOTER */

footer {
    padding: 35px 10%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 12px;
}

/* RESPONSIVE DESIGN */

@media (max-width: 900px) {
    .navbar {
        padding: 15px 5%;
    }

    .navbar nav {
        gap: 12px;
    }

    .navbar nav a {
        font-size: 11px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding-top: 70px;
    }

    .hero-visual {
        margin-top: 20px;
    }
}

@media (max-width: 600px) {
    .navbar {
        flex-wrap: wrap;
        gap: 15px;
    }

    .navbar nav {
        order: 3;
        width: 100%;
        overflow-x: auto;
        padding-bottom: 5px;
    }

    .nav-btn {
        font-size: 11px;
    }

    .section {
        padding: 65px 6%;
    }

    .section-heading h2 {
        font-size: 30px;
    }

    .hero h1 {
        font-size: 48px;
    }

    .stats {
        margin: 0 6%;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
    }

    .skills-grid,
    .projects-grid,
    .achievement-grid {
        grid-template-columns: 1fr;
    }

    footer {
        justify-content: center;
        text-align: center;
    }
}